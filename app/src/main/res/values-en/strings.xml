    <string name="onb_start">Get started</string>
    <string name="onb_p1_title">Take stock of your apps</string>
    <string name="onb_p1_body">List, search and analyse your installed apps so you can decide what to keep. This is not a launcher — it does not replace your home screen.</string>
    <string name="onb_p2_title">Organising stays inside this app</string>
    <string name="onb_p2_body">Tags, favourites and hidden apps only affect the lists inside AppShelf. Your home screen and app drawer are untouched. Only uninstalling actually removes an app, and Android always shows its own confirmation.</string>
    <string name="onb_p3_title">Nothing leaves your device</string>
    <string name="onb_p3_body">This app does not declare the internet permission, so it is technically unable to send anything anywhere. No ads, no analytics.</string>
    <string name="onb_p4_title">Usage access (optional)</string>
    <string name="onb_p4_body">To show last-used dates, screen time and app sizes, Android requires the special "Usage access" setting to be enabled.\n\nWithout it you can still use the list, search, tags and permission views. You can change this at any time in Settings.</string>

    <string name="usage_access_title">Usage access</string>
    <string name="usage_access_banner_title">Usage access is not granted</string>
    <string name="usage_access_banner_body">Grant it to see last-used dates, screen time and app sizes.</string>
    <string name="usage_access_grant">Grant</string>
    <string name="usage_access_later">Later</string>
    <string name="usage_access_granted">Granted</string>
    <string name="usage_access_not_granted">Not granted</string>
    <string name="usage_access_why_title">What it is used for</string>
    <string name="usage_access_why_body">This permission is used for three things only:\n\n• Last time each app was opened\n• Screen time over the last 7 and 30 days\n• App size (app, data, cache)\n\nEverything read is stored in a local database on this device and is never transmitted anywhere.</string>
    <string name="usage_access_open_settings">Open Android settings</string>
    <string name="usage_access_howto">When the settings screen opens, find "%1$s" in the list and turn the switch on.</string>

