<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以降のバックアップ／端末間転送のルール -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="appshelf.db" />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="appshelf.db" />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
